{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .venv/bin/python ] || (python3 -m venv .venv && .venv/bin/pip install -q -e '.[dev,notebooks,docs]')",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
